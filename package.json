{
  "name": "pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sales follow-up engine: one Cloudflare Worker per client copy.",
  "scripts": {
    "dev": "node scripts/dev.mjs --port 4821",
    "preview": "node scripts/dev.mjs --port 4822 --fresh",
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/a11y",
    "types": "wrangler types src/worker-configuration.d.ts",
    "test:worker": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --disable-warning=ExperimentalWarning --import ./tests/helpers/workers-runtime.mjs --test \"src/**/*.test.ts\" \"scripts/*.test.ts\" \"scripts/*.test.mjs\"",
    "test:e2e": "node scripts/build.mjs && node scripts/e2e.mjs",
    "test:a11y": "playwright test",
    "test:lighthouse": "node scripts/lighthouse.mjs",
    "screenshots": "playwright test -c playwright.screenshots.config.ts",
    "check:config": "node scripts/check-config.mjs",
    "check:fast": "npm run check:process && node scripts/check-fast.mjs",
    "check:process": "node scripts/check-process.mjs",
    "copies:provision": "node scripts/copies.mjs provision",
    "copies:update": "node scripts/copies.mjs update",
    "copies:export": "node scripts/copies.mjs export",
    "import:contacts": "node scripts/import-csv.ts",
    "check": "npm run check:process && npm run check:config && npm run lint && npm run typecheck && npm run test:worker && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "1.65.1",
    "@types/node": "^20",
    "eslint": "^9",
    "typescript": "^5",
    "typescript-eslint": "8.73.0",
    "wrangler": "4.164.0"
  },
  "overrides": {
    "playwright-core": "1.65.0",
    "basic-ftp": "6.2.6",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1",
      "@isaacs/nonrecursive-glob-match": "1.0.3"
    }
  },
  "engines": {
    "node": ">=22.19",
    "npm": ">=10.9.2 <11"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.33.0",
    "postal-mime": "4.2.1",
    "zod": "4.6.7"
  }
}
